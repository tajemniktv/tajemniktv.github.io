---
import ElsewhereCard from "../components/cards/ElsewhereCard.astro";
import GlassCard from "../components/common/GlassCard.astro";
import MobileHeader from "../components/MobileHeader.astro";
import Sidebar from "../components/Sidebar.astro";
import { siteData } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const { socials, bio, secondaryBio } = siteData;
---

<BaseLayout
	title="Connect | TajemnikTV"
	description="Verified public links and profile context for TajemnikTV."
>
	<div class="flex min-h-screen w-full relative">
		<Sidebar />

		<main
			class="flex-1 lg:ml-36 px-6 py-8 lg:pr-12 w-full max-w-250 mx-auto flex flex-col"
		>
			<MobileHeader />

			<header class="mb-12">
				<h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">Connect</h1>
				<p class="text-lg text-gray-300 max-w-2xl">
					The public trail. No fake contact form, no mystery inbox, and no
					ceremonial “let’s connect” button that emails a void.
				</p>
			</header>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<GlassCard class="p-8 flex flex-col justify-between">
					<div>
						<h2 class="text-2xl font-bold text-white mb-4">Public signals</h2>
						<p class="text-gray-300 mb-6 leading-relaxed">
							This site is mostly an identity hub and project index. GitHub is
							the best place for the technical trail; the profiles below cover
							the rest.
						</p>
						<p class="text-gray-300 mb-8 leading-relaxed">{bio}</p>
						<p class="text-gray-400 leading-relaxed">{secondaryBio}</p>
					</div>

					<div class="mt-8 rounded-2xl border border-white/10 bg-white/4 p-4">
						<p
							class="text-xs font-bold uppercase tracking-[0.18em] text-primary mb-2"
						>
							Verified links only
						</p>
						<p class="text-sm text-gray-400 leading-relaxed">
							Other profiles stay off the list until there is a stable public URL
							worth pointing at. Link rot is tedious enough without manufacturing it.
						</p>
					</div>
				</GlassCard>

				<div class="flex flex-col gap-6">
					<ElsewhereCard links={socials} />

					<GlassCard
						class="p-6 bg-[linear-gradient(145deg,rgba(36,29,44,0.9),rgba(24,19,30,0.9))] border-white/10"
					>
						<h3
							class="text-xl font-bold text-white mb-2 flex items-center gap-2"
						>
							<span class="material-symbols-outlined" aria-hidden="true">handyman</span>
							Current posture
						</h3>
						<p class="text-sm text-gray-300 mb-4">
							Building, modding, profiling, reading, debugging, and occasionally
							shipping the useful parts instead of opening another profiler window.
						</p>
						<div
							class="flex items-center gap-2 text-xs font-bold text-indigo-300 uppercase tracking-widest"
						>
							Mode: <span class="text-gray-200">Curious tinkering</span>
						</div>
					</GlassCard>
				</div>
			</div>
		</main>
	</div>
</BaseLayout>
